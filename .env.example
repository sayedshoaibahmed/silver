# Database (Neon Postgres)
# Local: postgresql://USER:PASS@localhost:5432/DB
# Vercel Production: Neon pooled URI (hostname contains -pooler) + sslmode=require
DATABASE_URL=

# drizzle-kit push / generate against Neon: direct (non-pooler) URI + sslmode=require
# Omit locally — db:push uses DATABASE_URL. Never commit the value.
# DATABASE_URL_UNPOOLED=

# Auth.js — generate with: openssl rand -base64 32
# Production (Vercel Production env): required, ≥32 chars, never the local CI placeholder.
AUTH_SECRET=

# Canonical Auth.js URL on the live host (https). Omit locally so cookies work on http://127.0.0.1.
# AUTH_URL=https://www.silversandhomestay.com

# Owner admin (seed script only — hashed into admin_users, not read at login)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL (canonical, OG, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.silversandhomestay.com

# Google Places API (New) — server-side only. Never prefix with NEXT_PUBLIC_.
# Place Details field mask: reviews only. Cache is 24h in getGoogleReviews().
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Google Maps Embed API — appears in the iframe URL (client-visible by design).
# Restrict this key to HTTP referrers for silversandhomestay.com (+ preview hosts).
# Do not use the Places server key here unrestricted.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Preview lock: on Vercel Preview, /admin and PATCH /api/admin/pricing are off by default.
# Set true to force-disable anywhere; ALLOW_ADMIN_ON_PREVIEW=true only with a non-prod DB.
# DISABLE_ADMIN_ON_PREVIEW=true
# ALLOW_ADMIN_ON_PREVIEW=true
